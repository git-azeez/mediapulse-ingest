{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediapulse.invalid/contracts/schemas/events.schema.json",
  "title": "MediaPulse Ingest event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "aggregateId",
    "aggregateVersion",
    "ownerId",
    "occurredAt",
    "correlationId",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string" },
    "eventType": { "enum": ["MediaRegistered", "CheckpointRecorded"] },
    "aggregateId": { "type": "string" },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/mediaRegistered" },
        { "$ref": "#/$defs/checkpointRecorded" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "MediaRegistered" } } },
      "then": {
        "properties": {
          "aggregateVersion": { "const": 1 },
          "data": { "$ref": "#/$defs/mediaRegistered" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "CheckpointRecorded" } } },
      "then": {
        "properties": {
          "aggregateVersion": { "type": "integer", "minimum": 2 },
          "data": { "$ref": "#/$defs/checkpointRecorded" }
        }
      }
    }
  ],
  "$defs": {
    "mediaRegistered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "origin", "destination"],
      "properties": {
        "kind": { "const": "mediaRegistered" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 128 },
        "origin": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "checkpointRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checkpointId", "status", "location"],
      "properties": {
        "kind": { "const": "checkpointRecorded" },
        "checkpointId": { "type": "string" },
        "status": { "$ref": "#/$defs/checkpointStatus" },
        "location": { "type": "string", "minLength": 1, "maxLength": 256 },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "checkpointStatus": {
      "enum": [
        "INGESTED",
        "TRANSCODING",
        "PACKAGED",
        "QC_PASSED",
        "PUBLISHED",
        "EXCEPTION"
      ]
    }
  }
}
